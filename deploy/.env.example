# Copy to deploy/.env on the server. `scripts/server-setup.sh` fills the secrets for you.
DOMAIN=gnarcadia.com
ACME_EMAIL=you@gnarcadia.com

# Secrets (32+ random bytes each; generated by server-setup.sh)
POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_SECRET=
ADMIN_API_KEY=
DEV_API_KEY=

# First admin (created on first boot if missing; also unlocks /analytics-hub)
ADMIN_EMAIL=you@gnarcadia.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Test phase (play money) ----
# Until payment / KYC / geo vendors are contracted, run with mocks so you can test on real devices.
# The arcade shows a "Test mode" banner while this is on. Flip providers to real ones for launch.
ALLOW_MOCK_PROVIDERS=true
GEO_PROVIDER=mock
GEO_DEV_REGION=CA-ON
KYC_PROVIDER=mock
KYC_AUTO_APPROVE=true
PAYMENT_PROVIDER=mock
SEED_DEMO_DATA=false
SYNC_EXAMPLE_GAMES=true

# ---- Real providers (fill in when ready, then set ALLOW_MOCK_PROVIDERS=false) ----
# GEO_PROVIDER=ipinfo
# IPINFO_TOKEN=
# KYC_PROVIDER=didit
# DIDIT_API_KEY=
# DIDIT_WORKFLOW_ID=
# DIDIT_WEBHOOK_SECRET=
# PAYMENT_PROVIDER=nuvei

TERMS_VERSION=2026-10-01
GEO_CHECK_TTL_MIN=30
