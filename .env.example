# ---- Shared ----
NODE_ENV=development
JWT_SECRET=change-me-dev-secret-at-least-32-chars-long!!
INTERNAL_SECRET=change-me-internal-hmac-secret
ADMIN_API_KEY=dev-admin-key
DEV_API_KEY=dev-upload-key

# ---- API ----
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_ARCADE_URL=http://localhost:5173
PUBLIC_REALTIME_URL=ws://localhost:4100
# DATABASE_URL unset => embedded PGlite in ./.pglite (zero-config dev). Set a Postgres URL in prod.
# DATABASE_URL=postgres://user:pass@host:5432/gnarcadia
STORAGE_DIR=./storage

# Providers: mock | ipapi | maxmind  (geo),  mock | didit | veriff (kyc),  mock | nuvei | aeropay (payments)
GEO_PROVIDER=mock
GEO_DEV_REGION=CA-ON
IPINFO_TOKEN=
KYC_PROVIDER=mock
PAYMENT_PROVIDER=mock

# ---- Realtime ----
REALTIME_PORT=4100
REALTIME_PUBLIC_URL=ws://localhost:4100
API_INTERNAL_URL=http://localhost:4000
