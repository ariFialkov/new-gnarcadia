    "@fastify/static": "^8.2.0",
    "@gnarcadia/protocol": "workspace:*",
    "adm-zip": "^0.5.16",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5"
