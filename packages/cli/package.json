{
  "name": "@gnarcadia/cli",
  "version": "0.1.0",
  "description": "Gnarcadia developer CLI: scaffold, run, validate, pack and publish games",
  "type": "module",
  "bin": { "gnarcadia": "./dist/index.js" },
  "main": "./dist/index.js",
  "files": ["dist", "templates"],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@gnarcadia/protocol": "workspace:*",
    "adm-zip": "^0.5.16",
    "esbuild": "^0.25.9"
  },
  "devDependencies": { "@types/adm-zip": "^0.5.7", "@types/node": "^22.18.6" }
}
